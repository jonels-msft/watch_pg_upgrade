# @synopsis: progress
# @description: A compact, grouped view of one watcher run (lnav 0.14.1).
# Indentation denotes ownership, not a stack of balanced start/end events.
# F5 reruns the query on growing input. The original log remains available with q.

;WITH events AS (
   SELECT log_line, log_level, fields,
          json_extract(fields, '$.event') AS event,
          json_extract(fields, '$.phase') AS phase,
          json_extract(fields, '$.stage') AS stage,
          json_extract(logfmt2json(log_text), '$.msg') AS message
   FROM logfmt_log
 ),
 flagged AS (
   SELECT *,
          CASE
            WHEN log_level IN ('error', 'critical', 'fatal')
              OR (event = 'phase_end' AND (json_extract(fields, '$.status') = 'fatal'
                  OR json_extract(fields, '$.status') LIKE 'failed%'))
              OR (event = 'outcome' AND json_extract(fields, '$.result') = 'failed') THEN 'error'
            WHEN log_level = 'warning' OR event = 'phase_unfinished'
              OR (event = 'phase_end' AND json_extract(fields, '$.status') IN ('notice', 'warning'))
              OR (event = 'outcome' AND json_extract(fields, '$.result') IN
                  ('exit_unverified', 'incomplete', 'missing_banner')) THEN 'warn'
            ELSE ''
          END AS alert
   FROM events
 )
 SELECT printf('%.1fs', json_extract(fields, '$.elapsed_s')) AS report,
        CASE WHEN phase IS NOT NULL THEN printf('#%02d', phase) ELSE '' END AS phase,
        alert,
        CASE
          WHEN event = 'stage' THEN printf('Stage %d. ', stage)
          WHEN event = 'stage_summary' THEN printf('Summary %d. ', stage)
          WHEN event IN ('phase_start', 'phase_end', 'phase_active', 'phase_unfinished')
            THEN '  '
          WHEN phase IS NOT NULL THEN '    '
          ELSE ''
        END ||
        CASE event
          WHEN 'child_logs' THEN 'Child logs: ' || message
          WHEN 'phase_active' THEN message || ' [completion not observed]'
          WHEN 'phase_unfinished' THEN message || ' [completion not observed]'
          WHEN 'phase_end' THEN message ||
            CASE WHEN json_extract(fields, '$.status') IS NOT 'ok'
              THEN ' [' || coalesce(json_extract(fields, '$.status'), 'phase outcome unknown') || ']'
              ELSE '' END
          WHEN 'db_activity' THEN
            coalesce(nullif(json_extract(fields, '$.db'), ''),
                     'oid=' || json_extract(fields, '$.db_oid'), '?') || ': ' ||
            CASE WHEN json_type(fields, '$.activity_messages') = 'integer'
              THEN printf('%,d %s | ',
                     json_extract(fields, '$.activity_messages'),
                     CASE WHEN json_extract(fields, '$.activity_messages') = 1
                       THEN rtrim(json_extract(fields, '$.activity_unit'), 's')
                       ELSE json_extract(fields, '$.activity_unit') END)
              WHEN json_type(fields, '$.object_starts') = 'integer'
              THEN printf('%,d starts | ', json_extract(fields, '$.object_starts'))
              ELSE '' END || message
          WHEN 'db_interval' THEN
            coalesce(nullif(json_extract(fields, '$.db'), ''),
                     'oid=' || json_extract(fields, '$.db_oid'), '?') || ': ' || message ||
            CASE
              WHEN json_extract(fields, '$.timing') = 'unknown' THEN ' [elapsed unknown]'
              WHEN json_extract(fields, '$.timing') = 'coalesced'
                THEN ' [elapsed below observation resolution]'
              ELSE printf(' [%.3fs between log observations]',
                          json_extract(fields, '$.interval_s'))
            END
          WHEN 'quiet' THEN
            printf('%.3fs without meaningful log activity',
                   json_extract(fields, '$.quiet_s')) ||
            CASE WHEN json_extract(fields, '$.last_message') IS NOT NULL
              THEN ' | last: ' ||
                coalesce(nullif(json_extract(fields, '$.db'), ''),
                         'oid=' || json_extract(fields, '$.db_oid'),
                         json_extract(fields, '$.source'), '') || ': ' ||
                json_extract(fields, '$.last_message')
              ELSE '' END ||
            CASE WHEN json_extract(fields, '$.bytes_ago_s') IS NOT NULL
              THEN printf(' | raw bytes %.3fs ago', json_extract(fields, '$.bytes_ago_s'))
              ELSE '' END ||
            CASE WHEN phase IS NULL THEN ' | ' || message ELSE '' END
          WHEN 'last_activity' THEN
            'Last log message: ' || coalesce(nullif(json_extract(fields, '$.db'), ''),
                     'oid=' || json_extract(fields, '$.db_oid'), 'main') || ': ' || message
          WHEN 'resumed' THEN
            printf('Log activity resumed after %.3fs quiet',
                   json_extract(fields, '$.quiet_s'))
          WHEN 'context' THEN 'Possible unlogged work: ' || message
          WHEN 'restore_totals' THEN
            printf('%,d object starts (%,d table, %,d constraint, %,d index, %,d other); not completions',
                   json_extract(fields, '$.object_starts'),
                   coalesce(json_extract(fields, '$.table_starts'), 0),
                   coalesce(json_extract(fields, '$.constraint_starts'), 0),
                   coalesce(json_extract(fields, '$.index_starts'), 0),
                   coalesce(json_extract(fields, '$.other_starts'), 0))
          WHEN 'transfer' THEN
            printf('%,d file-operation messages; not completed files',
                   json_extract(fields, '$.file_messages'))
          WHEN 'stage_summary' THEN message ||
            printf(' [%d/%d phases complete; %s; %d untimed]',
                   json_extract(fields, '$.complete'), json_extract(fields, '$.phases'),
                   coalesce(json_extract(fields, '$.timing'), 'unknown'),
                   json_extract(fields, '$.untimed'))
          ELSE message
        END ||
        CASE
          WHEN event = 'db_activity' AND json_extract(fields, '$.timing') = 'unknown'
            THEN ' [earlier timing unknown]'
          WHEN event NOT IN ('phase_end', 'phase_active') THEN ''
          WHEN json_extract(fields, '$.timing') = 'unknown' THEN ' [duration unknown]'
          WHEN json_extract(fields, '$.timing') = 'coalesced' THEN ' [coalesced]'
          WHEN json_type(fields, '$.duration_s') IN ('integer', 'real')
            THEN printf(' [%.3fs observed]', json_extract(fields, '$.duration_s'))
          ELSE ''
        END ||
        CASE WHEN event = 'phase_end' AND json_type(fields, '$.file_messages') = 'integer'
          THEN printf(' | %,d file-operation messages; not completed files',
                      json_extract(fields, '$.file_messages'))
          ELSE '' END AS activity,
        json_object('columns', json_object(
          'report', json_object('text-align', 'end'),
          'phase', json_object('text-align', 'start'),
          'alert', CASE
            WHEN alert = 'warn'
              THEN json_object('text-align', 'start', 'color', '#d7af00')
            WHEN alert = 'error'
              THEN json_object('text-align', 'start', 'color', '#ff5f5f')
            ELSE json_object('text-align', 'start')
          END,
          'activity', json_object('text-align', 'start')
        )) AS __lnav_style__
 FROM flagged AS e
 WHERE (event NOT IN ('observer_start', 'notice')
        AND (event <> 'db_interval' OR json_extract(fields, '$.boundary') = 'next_category')
        AND (event <> 'last_activity' OR NOT EXISTS (
          SELECT 1 FROM events AS q WHERE q.event = 'quiet'
            AND json_extract(q.fields, '$.elapsed_s') = json_extract(e.fields, '$.elapsed_s')
            AND json_extract(q.fields, '$.last_message') IS NOT NULL
        ))
        AND (event <> 'stage_summary'
          OR EXISTS (SELECT 1 FROM events WHERE event = 'attached')
          OR NOT EXISTS (
          SELECT 1 FROM events AS s WHERE s.event = 'stage' AND s.stage = e.stage
        )))
    OR log_level IN ('warning', 'error', 'critical', 'fatal')
 ORDER BY log_line;

:alt-msg q: raw log; F5: refresh. Times = reports; starts != completions; quiet != stalled; coalesced != zero.
