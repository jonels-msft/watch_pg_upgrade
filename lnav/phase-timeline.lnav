# @synopsis: phase-timeline
# @description: Group one saved watcher log into phase operations (lnav 0.14.1).
# Bars span report timestamps, not execution time. Single-record phases have no bar.
# Run this preset again after loading more records; F5 alone does not map new events.

;DROP TABLE IF EXISTS temp.watch_pg_upgrade_phases;

# Read the labels before assigning operations: querying logfmt_log during the
# all_opids update can invalidate lnav's operation descriptions.
;CREATE TEMP TABLE watch_pg_upgrade_phases AS
 SELECT printf('phase-%02d', json_extract(fields, '$.phase')) AS opid,
        '[' || coalesce(json_extract(fields, '$.status'),
          CASE json_extract(fields, '$.event')
            WHEN 'phase_unfinished' THEN 'unfinished' ELSE 'active' END)
        || '; ' || CASE
          WHEN json_extract(fields, '$.timing') = 'unknown' THEN 'duration unknown'
          WHEN json_extract(fields, '$.timing') = 'coalesced' THEN 'coalesced'
          WHEN json_type(fields, '$.duration_s') IN ('real', 'integer')
            THEN printf('%.3fs observed', json_extract(fields, '$.duration_s'))
          ELSE 'duration pending'
        END || '] ' || json_extract(logfmt2json(log_text), '$.msg') AS description,
        row_number() OVER (
          PARTITION BY json_extract(fields, '$.phase') ORDER BY log_line DESC
        ) AS latest
 FROM logfmt_log
 WHERE json_type(fields, '$.phase') = 'integer'
   AND json_extract(fields, '$.event') IN
     ('phase_start', 'phase_end', 'phase_active', 'phase_unfinished');

;UPDATE logfmt_log
 SET log_opid = printf('phase-%02d', json_extract(fields, '$.phase'))
 WHERE json_type(fields, '$.phase') = 'integer';

;UPDATE all_opids
 SET description = (
   SELECT description FROM watch_pg_upgrade_phases
   WHERE watch_pg_upgrade_phases.opid = all_opids.opid AND latest = 1
 )
 WHERE opid GLOB 'phase-*';

:switch-to-view timeline
:hide-in-timeline logfile
:alt-msg Bars = report spans, not phase durations. Coalesced != zero. Enter: messages; q: back.
